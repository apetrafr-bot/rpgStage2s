      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6336434230233824090, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: isZelda
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: items.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: dialogue.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[0]'
      value: "ZELDA LINKEDIN\u2026 Mais t\u2019\xE9tais o\xF9 bordel. J\u2019ai cru
        que t\u2019\xE9tais mort, disparu, ou pire\u2026 que t\u2019avais encore
        oubli\xE9 l\u2019heure."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[1]'
      value: "LINKEDIN Zelda\u2026 J\u2019ai couru partout pour toi. J\u2019ai failli
        mourir quinze fois, me battre contre des monstres moches, et j\u2019ai m\xEAme
        parl\xE9 \xE0 des PNJ chelous. Tout \xE7a juste pour te retrouver."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[2]'
      value: "ZELDA T\u2019es vraiment un bouffon\u2026 mais t\u2019es mon bouffon. 
        (Elle s\u2019approche, le regarde de haut en bas)  T\u2019es bless\xE9, t\u2019es
        sale, t\u2019es en retard\u2026 mais t\u2019es vivant. Et \xE7a, \xE7a me
        suffit."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[3]'
      value: "J\u2019te l\xE2cherai plus jamais. Promis. M\xEAme si la for\xEAt essaye
        encore de me manger."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[4]'
      value: "ZELDA Allez viens. On rentre. Et cette fois, tu dors PAS jusqu\u2019\xE0
        midi."
      objectReference: {fileID: 0}
    - target: {fileID: 7624053855340475449, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_Name
      value: pnj
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: d4cd43f4ae70a5e4689289a7913ae5b2, type: 3}
