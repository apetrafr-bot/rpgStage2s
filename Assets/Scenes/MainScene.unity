    - target: {fileID: 6336434230233824090, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6336434230233824090, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: npcId
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: dialogue.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[0]'
      value: "Eh oh LINKEDIN, attends deux secondes. Tu vas vraiment rentrer dans
        le donjon comme \xE7a, en mode touriste ?"
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[1]'
      value: "Parce que\u2026 j\u2019te pr\xE9viens hein\u2026 ce truc-l\xE0, il
        est chelou de fou."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[2]'
      value: "\xC0 chaque fois que t\u2019y rentres, BOUM, il se recr\xE9e tout seul.
        Les salles changent, les monstres changent, m\xEAme les coffres ils bougent
        comme s\u2019ils avaient des jambes."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[3]'
      value: "J\u2019sais pas qui a construit ce machin, mais clairement il avait
        pas une vie facile."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[4]'
      value: "Bref, si tu ressors vivant, tu me raconteras. Parce que moi j\u2019y
        retourne plus jamais. J\u2019ai encore des cauchemars du couloir qui tournait
        en rond."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: items.Array.data[0].item
      value: 
      objectReference: {fileID: 11400000, guid: 401f052b638dc114a97dd3f44a0fd8c1,
        type: 2}
    - target: {fileID: 7624053855340475449, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_Name
      value: pnj (7)
      objectReference: {fileID: 0}
    - target: {fileID: 9130917404974878672, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
