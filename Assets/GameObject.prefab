      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[0]'
      value: "T\u2019es toujours pas avec ta meuf Linkedin ??"
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[1]'
      value: "Elle va devenir folle si tu l\u2019a rejoins pas tr\xE8s vite."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[2]'
      value: "Par contre, fait gaffe dans la foret Linkedin, j\u2019ai entendu dire
        qu\u2019il y avait des monstres qui \xE9taient apparus depuis peu. Prend
        cette arme,"
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[3]'
      value: "elle t\u2019aidera mieux que cette vieille arme en bois que tu trimballes
        partout."
      objectReference: {fileID: 0}
