      propertyPath: dialogue.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[0]'
      value: "T\u2019es encore l\xE0 toi et t\u2019as toujours pas travers\xE9 le
        portail LinkedIn ?? Tu veux qu\u2019il se referme sur ta t\xEAte ou quoi."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[1]'
      value: "D\xE9p\xEAche\u2011toi, ta meuf t\u2019attend d\xE9j\xE0 de l\u2019autre
        c\xF4t\xE9, et crois\u2011moi\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[2]'
      value: "si tu la fais patienter plus longtemps, c\u2019est pas les monstres
        qui vont te faire le plus peur."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[3]'
      value: "Par contre, fais gaffe : la For\xEAt LinkedIn, c\u2019est plus ce que
        c\u2019\xE9tait."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[4]'
      value: "On dit que des cr\xE9atures cheloues sont apparues depuis peu."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[5]'
      value: "On dit que des cr\xE9atures cheloues sont apparues depuis peu."
      objectReference: {fileID: 0}
    - target: {fileID: 7368075324813034071, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: 'dialogue.Array.data[6]'
      value: "Allez, traverse le portail. Et essaie de pas mourir, \xE7a ferait mauvais
        genre."
      objectReference: {fileID: 0}
    - target: {fileID: 7624053855340475449, guid: d4cd43f4ae70a5e4689289a7913ae5b2,
        type: 3}
      propertyPath: m_Name
      value: pnj (5)
